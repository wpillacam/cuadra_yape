{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "db:setup": "prisma generate && prisma migrate deploy",
    "db:postgres": "npm run db:postgres:generate && npm run db:postgres:migrate",
    "db:postgres:generate": "prisma generate --schema prisma/postgresql/schema.prisma",
    "db:postgres:migrate": "prisma migrate deploy --schema prisma/postgresql/schema.prisma",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js"
  },
  "dependencies": { "@prisma/client": "6.19.3", "dotenv": "^16.6.1", "express": "^5.1.0" },
  "devDependencies": { "prisma": "6.19.3" }
}
