generator client {
  provider = "prisma-client-js"
}

model Administrador {
  id         String @id
  claveHash  String
  sesionKey  String

  @@map("administradores")
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Venta {
  caja             String
  id               String
  dia              String
  fecha            DateTime
  metodo           String
  montoCentimos    Int
  descripcion      String
  nota             String
  foto             Bytes?

  @@id([caja, id])
  @@index([caja, dia, fecha])
  @@map("ventas")
}

model CierreDia {
  caja      String
  dia       String
  cerradoEn DateTime

  @@id([caja, dia])
  @@map("cierre_dia")
}

model Cliente {
  id           String   @id
  negocio      String
  rubro        String
  nombre       String
  apellido     String
  dni          String
  correo       String
  telefono     String
  inicio       String
  fin          String
  usuario      String   @unique
  claveHash    String
  creadoEn     DateTime @default(now())

  @@map("clientes")
}
